{
  "name": "cc-checkout-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the auto-scaling e-commerce checkout system",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^4.1.11"
  }
}
