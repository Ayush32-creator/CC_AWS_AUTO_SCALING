# Local development settings for docker compose.
# Copy to .env (which is git-ignored) and change the password:
#   copy .env.example .env        (cmd)
#   cp .env.example .env          (bash)
# These are LOCAL-ONLY values. On AWS the DB password is managed by
# Secrets Manager and never stored in files.

POSTGRES_USER=checkout
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=checkout
# Host port for the Docker Postgres. 5433 avoids clashing with a natively
# installed PostgreSQL that already listens on 5432.
POSTGRES_PORT=5433
# Host port for the app
APP_PORT=3000
